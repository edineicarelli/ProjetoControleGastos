# Configurações do Sistema de Gestão Financeira Inteligente (Telegram + IA)

# Token do Bot do Telegram (obtido através do @BotFather)
TELEGRAM_BOT_TOKEN="SEU_TELEGRAM_BOT_TOKEN_AQUI"

# Chave de API do Google Gemini (para NLP, áudio e OCR de comprovantes)
GEMINI_API_KEY="SUA_GEMINI_API_KEY_AQUI"

# Banco de Dados (SQLite por padrão, ou postgresql+psycopg2://user:pass@localhost:5432/finance)
DATABASE_URL="sqlite:///./finance_control.db"

# Configurações do Servidor Web / Dashboard (Porta padrão 8085 para Produção)
HOST="0.0.0.0"
PORT=8085
BASE_URL="http://localhost:8085"

# Moeda padrão e Fuso Horário
DEFAULT_CURRENCY="R$"
DEFAULT_TIMEZONE="America/Sao_Paulo"
